<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    ⚠ ${revision}, never a literal version — every other module does the same and it is not
    cosmetic. The root pom is itself <version>${revision}</version> (the CI-friendly pattern,
    resolved at install time by flatten-maven-plugin), so a hard-coded parent version does not
    match the pom sitting at relativePath and Maven falls back to the repository. On a developer
    machine that SUCCEEDS, because a previous `mvn install` left eyeandsickle-parent there — and
    it fails on a clean checkout with "'parent.relativePath' points at wrong local POM", which
    is exactly how this reached CI green-locally and broken-there.
  -->
  <parent>
    <groupId>io.github.stoicswe.eyeandsickle</groupId>
    <artifactId>eyeandsickle-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>eyeandsickle-client-dist</artifactId>
  <name>The Eye and Sickle :: Client distributions</name>

  <!--
    Builds ONE RUNNABLE JAR PER PLATFORM, as part of a plain `mvn clean install`:

        client-dist/target/eyeandsickle-client-dist-<version>-win.jar
                                                    -mac.jar
                                                    -mac-aarch64.jar
                                                    -linux.jar
                                                    -linux-aarch64.jar

    each launched with `java -jar <file>` and needing only a JDK/JRE 25+ on the target.
    Nothing is compiled per platform — only a different set of prebuilt JavaFX natives is
    packaged — so all five come off ONE machine. That is the difference from jpackage, which
    bundles a runtime but cannot cross-compile.

    ⚠ WHY THIS IS A SEPARATE MODULE, and please do not fold it back into `client`.

    Shade can only filter the dependencies of the project it runs in, so producing five jars
    means all five JavaFX platform sets have to be declared as dependencies. Declaring them in
    `client` would put every platform's natives on that module's TEST and `javafx:run`
    classpath — and JavaFX resolves a native by OS-specific FILE NAME, so on an Apple Silicon
    Mac `libglass.dylib` from the x86_64 `mac` jar can shadow the arm64 one purely by classpath
    order. The failure is silent until something starts the toolkit. This module has no tests
    and nothing to run, so the pollution is harmless here and impossible there.

    ⚠ WHY NOT ONE JAR FOR ALL PLATFORMS — built, measured, rejected; see client/pom.xml. JavaFX
    natives are named for the OS but NOT the architecture, so the two Mac builds overwrite each
    other in a merged jar and the result dies on arm64 with
    `UnsatisfiedLinkError ... (have 'x86_64', need 'arm64')`.

    ⚠ These jars must run from the CLASSPATH. `Launcher` does not extend Application precisely
    so the JVM does not look for JavaFX on the module path before main() runs, and `java -jar`
    is a classpath launch. Do not add module-info.java to "clean this up".

    Skip the whole thing with `-Ddist.skip=true` when you want a fast build; five ~13 MB uber
    jars are not free.
  -->

  <properties>
    <dist.skip>false</dist.skip>
    <!-- Nothing here is Java. Skip the compiler and the test harness outright. -->
    <maven.test.skip>true</maven.test.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.stoicswe.eyeandsickle</groupId>
      <artifactId>eyeandsickle-client</artifactId>
      <version>${revision}</version>
    </dependency>

    <!--
      Every platform, explicitly. The classifier-less coordinates would resolve only to THIS
      machine's platform through org.openjfx's own os.name/os.arch profiles, which is exactly
      what this module exists not to do.
    -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <version>${javafx.version}</version>
      <classifier>win</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
      <classifier>win</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <classifier>win</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
      <classifier>win</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <version>${javafx.version}</version>
      <classifier>mac</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
      <classifier>mac</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <classifier>mac</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
      <classifier>mac</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <version>${javafx.version}</version>
      <classifier>mac-aarch64</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
      <classifier>mac-aarch64</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <classifier>mac-aarch64</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
      <classifier>mac-aarch64</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <version>${javafx.version}</version>
      <classifier>linux</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
      <classifier>linux</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <classifier>linux</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
      <classifier>linux</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <version>${javafx.version}</version>
      <classifier>linux-aarch64</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
      <classifier>linux-aarch64</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <classifier>linux-aarch64</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
      <classifier>linux-aarch64</classifier>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <configuration>
          <skip>${dist.skip}</skip>
          <createDependencyReducedPom>false</createDependencyReducedPom>
        </configuration>
        <executions>
          <execution>
            <id>shade-win</id>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>win</shadedClassifierName>
              <artifactSet>
                <excludes>
                    <exclude>org.openjfx:*:*:mac</exclude>
                    <exclude>org.openjfx:*:*:mac-aarch64</exclude>
                    <exclude>org.openjfx:*:*:linux</exclude>
                    <exclude>org.openjfx:*:*:linux-aarch64</exclude>
                </excludes>
              </artifactSet>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.stoicswe.eyeandsickle.client.Launcher</mainClass>
                  <manifestEntries>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
          <execution>
            <id>shade-mac</id>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>mac</shadedClassifierName>
              <artifactSet>
                <excludes>
                    <exclude>org.openjfx:*:*:win</exclude>
                    <exclude>org.openjfx:*:*:mac-aarch64</exclude>
                    <exclude>org.openjfx:*:*:linux</exclude>
                    <exclude>org.openjfx:*:*:linux-aarch64</exclude>
                </excludes>
              </artifactSet>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.stoicswe.eyeandsickle.client.Launcher</mainClass>
                  <manifestEntries>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
          <execution>
            <id>shade-mac-aarch64</id>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>mac-aarch64</shadedClassifierName>
              <artifactSet>
                <excludes>
                    <exclude>org.openjfx:*:*:win</exclude>
                    <exclude>org.openjfx:*:*:mac</exclude>
                    <exclude>org.openjfx:*:*:linux</exclude>
                    <exclude>org.openjfx:*:*:linux-aarch64</exclude>
                </excludes>
              </artifactSet>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.stoicswe.eyeandsickle.client.Launcher</mainClass>
                  <manifestEntries>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
          <execution>
            <id>shade-linux</id>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>linux</shadedClassifierName>
              <artifactSet>
                <excludes>
                    <exclude>org.openjfx:*:*:win</exclude>
                    <exclude>org.openjfx:*:*:mac</exclude>
                    <exclude>org.openjfx:*:*:mac-aarch64</exclude>
                    <exclude>org.openjfx:*:*:linux-aarch64</exclude>
                </excludes>
              </artifactSet>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.stoicswe.eyeandsickle.client.Launcher</mainClass>
                  <manifestEntries>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
          <execution>
            <id>shade-linux-aarch64</id>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>linux-aarch64</shadedClassifierName>
              <artifactSet>
                <excludes>
                    <exclude>org.openjfx:*:*:win</exclude>
                    <exclude>org.openjfx:*:*:mac</exclude>
                    <exclude>org.openjfx:*:*:mac-aarch64</exclude>
                    <exclude>org.openjfx:*:*:linux</exclude>
                </excludes>
              </artifactSet>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.stoicswe.eyeandsickle.client.Launcher</mainClass>
                  <manifestEntries>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
