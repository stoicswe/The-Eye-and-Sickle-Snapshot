# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# There are deliberately no working defaults for the credentials — a home server
# holds real, losable player state, so it should never start with a guessable
# password because someone skipped a step.

# The database is EMBEDDED (H2) since 2026-08-02 — there are no database
# credentials to set. State lives in the `gamedata` volume; back that up.
# --- database ---------------------------------------------------------------
# Generate one, do not invent one:  openssl rand -base64 32

# --- server -----------------------------------------------------------------
# Interface to publish the game port on. Keep 127.0.0.1 until you actually
# intend to accept players from outside this machine.
EYEANDSICKLE_BIND=127.0.0.1

# Comma-separated AT Protocol DIDs permitted to join (docs/architecture/01 §2).
# Empty means nobody — closed by default is intentional.
EYEANDSICKLE_ALLOWLIST_DIDS=

# --- federation -------------------------------------------------------------
# Opt-in. `false` gives you a purely local single-player or friends server: no
# directory listing, no validator duty, no cross-server item transfers, and
# none of the quorum machinery.
#
# To federate, set BOTH of these — the flag alone will not run the federation
# migrations:
#   EYEANDSICKLE_FEDERATION_ENABLED=true
#   SPRING_PROFILES_ACTIVE=federation
EYEANDSICKLE_FEDERATION_ENABLED=false
SPRING_PROFILES_ACTIVE=default
